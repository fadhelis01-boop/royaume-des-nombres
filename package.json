{
  "name": "royaume-des-nombres",
  "version": "1.2.0",
  "description": "Le Royaume des Nombres — apprendre les mathématiques de 7 ans à l'université avec Mia π, Néo Fibo et Zéro",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "content": "node scripts/build-content.mjs",
    "content:check": "rolldown scripts/check-content.ts --platform node --format esm -o .tmp/check.mjs --log-level warn && node .tmp/check.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run content && npm run content:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "dompurify": "^3.4.16",
    "js-yaml": "^5.4.3",
    "katex": "^0.19.0",
    "marked": "^18.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "rolldown": "^1.2.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
